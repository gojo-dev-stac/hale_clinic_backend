# Copy to .env and configure for your environment. Never commit real credentials.
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# PostgreSQL example: postgres://user:password@host:5432/database?sslmode=require
# Leave blank for local SQLite development.
DATABASE_URL=
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000
# SMTP is optional until credentials are provisioned. No credentials are included here.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Hale Clinic <no-reply@example.com>
NOTIFICATION_EMAIL=
